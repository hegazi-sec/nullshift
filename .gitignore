# Python
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# Test suite lives in the development repo only
tests/

# Environment & secrets (optional escape hatch for Docker/CI deployments)
.env
.env.*

# Runtime data — all auto-generated by setup.py and the running app
app/data/
data/chroma/

# Databases — anywhere
*.db
*.db-shm
*.db-wal
*.sqlite3

# Logs & audit trails
*.log
*.jsonl
logs/

# HTTP cookie jars (from local API testing)
cookies.txt

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# A 0.3.x install's downloaded package folder: unused since 0.4.0. Keep it ignored, or an
# install that still has it stops being a clean release checkout and no longer updates itself.
app/pro/
app/.pro-new-*/
app/.pro-old-*/
